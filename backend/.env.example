# Enterprise Knowledge AI: Configuration & Environment Variables

# App Environment
APP_NAME="Enterprise Knowledge AI"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Security & API Auth
API_KEY=ekai_test_secret_key_12345
AUTH_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_GEN_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# Embeddings (FastEmbed Local ONNX Models)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
SPARSE_MODEL=Qdrant/bm25

# Qdrant Vector DB (Qdrant Cloud or Local)
# For local in-memory: :memory:
# For local server: http://localhost:6333
# For Qdrant Cloud: https://xyz-example.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=enterprise_knowledge
QDRANT_PREFER_GRPC=false

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=60
MAX_FILE_SIZE_BYTES=52428800

# Retrieval & Caching
RETRIEVAL_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.35
MAX_REWRITE_RETRIES=2
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=2000
